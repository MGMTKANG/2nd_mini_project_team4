# 매치 단독 로컬 확인용 가짜 값. .env로 복사하며 실제 비밀값은 커밋하지 않는다.
MATCH_DB_USERNAME=match
MATCH_DB_PASSWORD=local-match-password-change-me
MARIADB_ROOT_PASSWORD=local-root-password-change-me
# JWT HMAC 키는 최소 32바이트이며, 실제 서비스 연동 시 유저 서비스와 맞춘다.
JWT_SECRET_KEY=local-only-fake-jwt-secret-at-least-32-bytes-change-me
JAVA_OPTS=-Xms128m
